APP_NAME=voice-note-collector
ENVIRONMENT=local

SECRET_KEY= # Required in all environments — no default

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USER=
TELEGRAM_WEBHOOK_SECRET= # Required in prod — must match the secret set in Telegram setWebhook call
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_NOTIFY_ON_TRANSCRIPTION=true  # Set to false to disable post-transcription Telegram confirmations

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY= # sb_publishable_...; low-privilege key for Supabase Auth
SUPABASE_SECRET_KEY= # sb_secret_...; server-only key for backend data access

WEB_ALLOWED_EMAIL= # The only Supabase Auth account allowed into the web library
WEB_COOKIE_SECURE= # Optional override; defaults to true in prod
# Temporary local UI preview only. Must remain false/unset in production.
WEB_AUTH_DISABLED=false

API_KEY= # Required in prod — sent as X-API-Key header by REST clients

GROQ_API_KEY=
